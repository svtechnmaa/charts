{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "seed": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "artifactSecret": {"type": "string"},
        "artifactKey": {"type": "string"},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 2},
        "deployAuth": {
          "type": "object",
          "properties": {
            "existingSecret": {"type": "string"},
            "key": {"type": "string"}
          }
        }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "frontendVip": {
          "type": "string",
          "anyOf": [{"const": ""}, {"format": "ipv4"}, {"format": "ipv6"}]
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "tls": {
          "type": "object",
          "properties": {
            "existingSecret": {"type": "string"},
            "certKey": {"type": "string", "minLength": 1},
            "privateKeyKey": {"type": "string", "minLength": 1},
            "certManager": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "secretName": {"type": "string"},
                "createIssuer": {"type": "boolean"},
                "issuerRef": {
                  "type": "object",
                  "properties": {
                    "name": {"type": "string"},
                    "kind": {"type": "string", "minLength": 1},
                    "group": {"type": "string", "minLength": 1}
                  }
                },
                "duration": {"type": "string", "minLength": 1},
                "renewBefore": {"type": "string", "minLength": 1},
                "dnsNames": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                },
                "ipAddresses": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "anyOf": [{"format": "ipv4"}, {"format": "ipv6"}]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
